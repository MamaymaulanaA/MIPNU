# =============================================================================
# MIPNU — Environment Variables
#
# Salin berkas ini menjadi `.env.local` lalu isi dengan kredensial nyata.
# `.env.local` TIDAK BOLEH di-commit (lihat .gitignore).
#
# JANGAN pernah mengisi berkas ini dengan secret sungguhan.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — nilai publik
#
# Kedua nilai di bawah memang dikirim ke browser. Keamanannya bergantung
# sepenuhnya pada Row Level Security, bukan pada kerahasiaan anon key.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# -----------------------------------------------------------------------------
# Supabase — service role
#
# BAHAYA: kunci ini melewati seluruh RLS policy.
#
#   - HANYA server-side.
#   - DILARANG memberi prefix NEXT_PUBLIC_.
#   - DILARANG diimpor dari Client Component.
#   - DILARANG dicetak ke log/console.
#
# Service role bukan solusi untuk policy RLS yang salah. Alur user biasa tetap
# memakai user-scoped client supaya RLS bekerja.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# -----------------------------------------------------------------------------
# Supabase CLI — hanya untuk generate types & push migration dari lokal.
# Bukan runtime secret aplikasi.
# -----------------------------------------------------------------------------
SUPABASE_PROJECT_ID="your-project-ref"

# -----------------------------------------------------------------------------
# Aplikasi
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Security test (tests/security)
#
# Uji keamanan berjalan terhadap database sungguhan: ia membuat dua organisasi
# sementara lalu memverifikasi RLS dari sisi user, bukan dari sisi aplikasi.
#
# Tanpa ketiga nilai ini seluruh uji di-SKIP, dan skip BUKAN lulus.
#
# Arahkan ke project pengembangan, bukan production: uji ini menulis lalu
# menghapus datanya sendiri.
# -----------------------------------------------------------------------------
TEST_SUPABASE_URL="https://your-project-ref.supabase.co"
TEST_SUPABASE_ANON_KEY="your-anon-key"
TEST_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# -----------------------------------------------------------------------------
# Provisioning Super Admin pertama (npm run provision:super-admin)
#
# HANYA dibaca skrip provisioning, tidak pernah oleh aplikasi. Isi sesaat
# ketika hendak menjalankan skrip, lalu kosongkan lagi — kredensial tidak
# perlu menetap di berkas environment.
#
# Skrip TIDAK menimpa kata sandi akun yang sudah ada.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME=""
