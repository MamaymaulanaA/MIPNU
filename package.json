{
  "name": "mipnu",
  "version": "0.1.0",
  "private": true,
  "description": "MIPNU — Manajemen Informasi Pelajar Nahdlatul Ulama",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --linked --schema public > types/database.types.ts",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:link": "supabase link",
    "test:security": "vitest run tests/security",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "provision:super-admin": "node --env-file=.env.local scripts/provision-super-admin.mjs",
    "maintenance:cleanup-profiles": "node --env-file=.env.local scripts/cleanup-orphan-profiles.mjs",
    "maintenance:cleanup-test-orgs": "node --env-file=.env.local scripts/cleanup-test-organizations.mjs",
    "maintenance:cleanup-sessions": "node --env-file=.env.local scripts/cleanup-attendance-sessions.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.3",
    "@dicebear/core": "^9.4.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
